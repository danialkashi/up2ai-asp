@{
    var c = (Cv)ViewData["Content"]!;
    var copy = c["copy"]["services"];
    var site = c["site"];
    var readyAgents = c["services"]["readyAgents"];
    var customTrack = c["services"]["customTrack"];
}
@* بخش خدمات.

   تفکیک بصری دو مسیر عمداً با «سطح» انجام شده، نه با رنگِ تزئینی:
   قالب‌های آماده کارت‌های روشن و هم‌اندازه‌اند (`bg-card`)، و مسیر سفارشی
   یک بلوک تیره‌ی تمام‌عرض است (`bg-ink`). این تفاوت خودش اطلاعات منتقل می‌کند.

   این بخش عمداً هیچ انیمیشنی ندارد — تنها نقطه‌های موشن‌دار سایت هیرو و دمو هستند. *@
<section id="services" class="border-b border-hairline bg-surface-2">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24 lg:py-28">
        @* سرتیتر بخش *@
        <div class="max-w-2xl">
            <span class="inline-flex items-center gap-2 rounded-full border border-brand/20 bg-brand/[0.06] px-3 py-1 text-[13px] font-medium text-brand-ink">@copy["eyebrow"]</span>
            <h2 class="mt-5 text-[1.75rem] font-bold leading-[1.45] tracking-tight text-on-light sm:text-[2.25rem]">@copy["heading"]</h2>
            <p class="mt-4 text-[15px] leading-[2] text-on-light-muted sm:text-[16px]">@copy["lead"]</p>
        </div>

        @* مسیر ۱ — قالب‌های آماده *@
        <div class="mt-12 flex flex-col gap-1.5 sm:mt-14 sm:flex-row sm:items-center sm:gap-3">
            <div class="flex items-center gap-2.5"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="h-[18px] w-[18px] shrink-0 text-brand"><path d="M13 2.5 4.5 13.2c-.3.4 0 1 .5 1H11l-1 7.3 8.5-10.7c.3-.4 0-1-.5-1H12l1-7.3Z"></path></svg><h3 class="text-[15px] font-bold text-on-light">@copy["readyTitle"]</h3></div>
            <span class="text-[13px] text-on-light-muted">@copy["readyNote"]</span>
            <span aria-hidden="true" class="hidden h-px flex-1 bg-hairline sm:block"></span>
        </div>

        <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var agent in readyAgents)
            {
                <li class="group flex h-full flex-col rounded-2xl border border-hairline bg-card p-5 transition-[border-color,box-shadow] duration-200 hover:border-brand/35 hover:shadow-[0_12px_34px_-18px_rgba(99,102,241,0.45)]"><partial name="_ServicePreview" model="@agent" /><h4 class="mt-5 text-[17px] font-bold text-on-light">@agent["title"]</h4>
                    @* برچسب زمان راه‌اندازی — روی زمینه‌ی روشن `brand-ink` می‌گیرد تا کنتراست AA بدهد. *@
                    <div class="mt-3"><span class="inline-flex items-center gap-1.5 rounded-lg px-2 py-1 text-[12px] font-medium bg-brand/[0.08] text-brand-ink"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="size-3.5 shrink-0"><circle cx="12" cy="12" r="9"></circle><path d="M12 7.2v5l3.2 1.9"></path></svg><span>@(copy["setupLabel"]): @(agent["setupTime"])</span></span></div>
                    <p class="mt-3.5 text-[14px] leading-[1.95] text-on-light-muted">@agent["pitch"]</p>
                    <ul class="mt-5 flex flex-col gap-2.5">@foreach (var point in agent["points"]){<li class="flex gap-2.5 text-[14px] leading-[1.8] text-on-light"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="mt-[7px] h-3 w-3 shrink-0 text-brand"><path d="m4.5 12.5 4.5 4.5L19.5 6.5"></path></svg><span>@point</span></li>}</ul>
                </li>
            }
        </ul>

        @* مسیر ۲ — کاملاً سفارشی *@
        <div class="mt-12 flex flex-col gap-1.5 sm:mt-14 sm:flex-row sm:items-center sm:gap-3">
            <div class="flex items-center gap-2.5"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="h-[18px] w-[18px] shrink-0 text-brand-2"><rect x="3" y="3" width="7.5" height="7.5" rx="2"></rect><rect x="13.5" y="3" width="7.5" height="7.5" rx="2"></rect><rect x="3" y="13.5" width="7.5" height="7.5" rx="2"></rect><path d="M17.25 13.5v7.5M21 17.25h-7.5"></path></svg><h3 class="text-[15px] font-bold text-on-light">@copy["customTitle"]</h3></div>
            <span class="text-[13px] text-on-light-muted">@copy["customNote"]</span>
            <span aria-hidden="true" class="hidden h-px flex-1 bg-hairline sm:block"></span>
        </div>

        <div class="mt-5 overflow-hidden rounded-2xl bg-ink">
            <div class="relative grid gap-8 p-7 sm:p-9 lg:grid-cols-[1.15fr_1fr] lg:items-center lg:gap-12">
                @* هاله‌ی ملایم برند، هم‌خانواده با هیرو *@
                <div class="pointer-events-none absolute -left-24 -top-24 h-72 w-72 rounded-full blur-[110px]" style="background:radial-gradient(circle, rgba(168,85,247,0.28), transparent 68%)" aria-hidden="true"></div>
                <div class="relative">
                    <h4 class="text-[19px] font-bold leading-[1.6] text-white sm:text-[22px]">@customTrack["title"]</h4>
                    <div class="mt-3.5"><span class="inline-flex items-center gap-1.5 rounded-lg px-2 py-1 text-[12px] font-medium bg-white/10 text-on-dark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="size-3.5 shrink-0"><circle cx="12" cy="12" r="9"></circle><path d="M12 7.2v5l3.2 1.9"></path></svg><span>@(copy["setupLabel"]): @(customTrack["setupTime"])</span></span></div>
                    <p class="mt-4 max-w-xl text-[14px] leading-[2] text-on-dark-muted sm:text-[15px]">@customTrack["body"]</p>
                    <a href="@site["cta"]["href"]" class="group mt-7 inline-flex items-center justify-center gap-2 rounded-2xl bg-gradient-to-l from-brand-deep to-brand-2-deep px-5 py-3 text-[15px] font-medium text-white shadow-[0_10px_30px_-10px_rgba(99,102,241,0.75)] transition-transform duration-200 hover:-translate-y-0.5">@copy["customCta"]<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="h-[18px] w-[18px] transition-transform duration-200 group-hover:-translate-x-1"><path d="M19 12H5"></path><path d="m11 6-6 6 6 6"></path></svg></a>
                </div>
                <div class="relative">
                    <ul class="flex flex-col gap-3.5 border-t border-white/10 pt-6 lg:border-s lg:border-t-0 lg:ps-8 lg:pt-0">@foreach (var point in customTrack["points"]){<li class="flex gap-2.5 text-[14px] leading-[1.85] text-on-dark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="mt-[7px] h-3 w-3 shrink-0 text-brand-soft"><path d="m4.5 12.5 4.5 4.5L19.5 6.5"></path></svg><span>@point</span></li>}</ul>
                </div>
            </div>
        </div>
    </div>
</section>
