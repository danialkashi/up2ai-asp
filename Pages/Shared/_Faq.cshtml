@{
    var c = (Cv)ViewData["Content"]!;
    var faq = c["copy"]["faq"];
    var faqs = c["faq"]["faqs"];
    var site = c["site"];
}
@* با `<details>/<summary>` بومی ساخته شده، نه با state — صفر جاوااسکریپت،
   و بدون hydration هم کار می‌کند. علامت + با `group-open:rotate-45` می‌چرخد. *@
<section id="faq" class="border-b border-hairline bg-surface-2">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24 lg:py-28">
        <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
            <div>
                <span class="inline-flex items-center rounded-full border border-brand/20 bg-brand/[0.06] px-3 py-1 text-[13px] font-medium text-brand-ink">@faq["eyebrow"]</span>
                <h2 class="mt-5 text-[1.75rem] font-bold leading-[1.45] tracking-tight text-on-light sm:text-[2.25rem]">@faq["heading"]</h2>
                <p class="mt-4 text-[15px] leading-[2] text-on-light-muted sm:text-[16px]">@faq["lead"]</p>
                <a href="@site["cta"]["href"]" class="mt-6 inline-flex min-h-11 items-center rounded-xl border border-hairline bg-card px-4 py-2.5 text-[14px] font-medium text-on-light transition-colors hover:border-brand/35">@site["cta"]["label"]</a>
            </div>
            <ul class="flex flex-col gap-2">@foreach (var item in faqs){<li><details class="group rounded-2xl border border-hairline bg-card px-5 transition-colors open:border-brand/25"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-[15px] font-medium text-on-light [&amp;::-webkit-details-marker]:hidden">@item["q"]<span aria-hidden="true" class="grid h-6 w-6 shrink-0 place-items-center rounded-full border border-hairline text-on-light-muted transition-transform duration-200 group-open:rotate-45"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 1.5v9M1.5 6h9"></path></svg></span></summary><p class="pb-5 pe-10 text-[14px] leading-[2] text-on-light-muted">@item["a"]</p></details></li>}</ul>
        </div>
    </div>
</section>
