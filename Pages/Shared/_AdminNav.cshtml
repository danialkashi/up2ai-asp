@model Up2Ai.Services.AdminNavModel
@using Up2Ai.Services
@{
    // فهرست بخش‌های پنل، گروه‌بندی‌شده.
    //
    // چرا گروه‌بندی: یازده بخشِ هم‌سطح، هرچقدر هم خوش‌نام باشند، فهرستی
    // می‌سازند که باید *خوانده* شود. با سه گروه، کاربر اول تصمیم می‌گیرد
    // «دنبال محتوام یا متن ثابت؟» و بعد بین سه چهار گزینه انتخاب می‌کند.
}

@functions {
    string ItemClass(bool on) =>
        "flex min-h-11 items-center justify-between gap-2 rounded-lg px-3 py-2 text-[13.5px] leading-[1.7] transition-colors "
        + (on
            ? "bg-brand/10 font-bold text-brand-ink"
            : "text-on-light-muted hover:bg-surface-2 hover:text-on-light");
}

<a href="/admin" class="@ItemClass(Model.OnHome)">
    <span>خانه‌ی پنل</span>
    <span aria-hidden="true" class="text-[12px] opacity-60">همه‌ی بخش‌ها</span>
</a>

@foreach (var group in AdminLabels.Groups)
{
    var keys = AdminLabels.SectionsInGroup(group.Key, Model.Available).ToList();
    if (keys.Count == 0) { continue; }

    <p class="mt-3 mb-1 border-t border-hairline px-3 pt-3.5 text-[11.5px] font-bold text-on-light-muted/80">@group.Title</p>
    @foreach (var key in keys)
    {
        var meta = AdminLabels.MetaFor(key);
        <a href="/admin/@key"
           aria-current="@(Model.ActiveTab == key ? "page" : null)"
           class="@ItemClass(Model.ActiveTab == key)">@meta.Title</a>
    }
}

<p class="mt-4 mb-1 px-3 text-[11.5px] font-bold text-on-light-muted/80">درخواست‌ها</p>
<a href="/admin/leads"
   aria-current="@(Model.OnLeads ? "page" : null)"
   class="@ItemClass(Model.OnLeads)">صندوق لید</a>
