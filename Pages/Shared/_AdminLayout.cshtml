@using System.Text.Json.Nodes
@using Up2Ai.Services
@inject Up2Ai.Services.ContentStore Store
@{
    // پوسته‌ی پنل مدیریت.
    //
    // پنل عمداً روشن است و هرگز نباید در نتایج جست‌وجو بیاید: متای noindex
    // را لایوت اصلی از روی ViewData["NoIndex"] می‌گذارد، و کنارش مسیر
    // /admin در robots.txt هم مسدود است.
    //
    // ناوبری = یک نوار تب افقی زیر هدر، در همه‌ی عرض‌ها یکسان. (ستون کناری
    // امتحان شد و کنار گذاشته شد: در پنجره‌های باریک یا با زوم مرورگر اصلاً
    // ظاهر نمی‌شد و کاربر با دو ناوبری متفاوت روبه‌رو می‌شد.)
    Layout = "_Layout";
    var c = (Cv)ViewData["Content"]!;
    var authed = ViewData["Authed"] as bool? ?? false;
    ViewData["Title"] = "پنل مدیریت";

    // فهرست بخش‌ها از خودِ شکل محتوا می‌آید، نه از یک لیست دستی — پس بخش
    // تازه‌ی محتوا خودکار در ناوبری هم پیدا می‌شود.
    var available = Store.Defaults is JsonObject defs ? defs.Select(p => p.Key).ToList() : new List<string>();
    var path = (Context.Request.Path.Value ?? "").TrimEnd('/').ToLowerInvariant();
    var activeTab = ViewData["ActiveTab"] as string ?? "";
}

<div class="min-h-screen bg-surface">
    <header class="border-b border-hairline bg-ink">
        <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6">
            <a href="/admin" class="-my-2 flex min-h-11 items-center gap-3 py-2">
                <partial name="_Logo" model="@(("light", "h-6 w-auto"))" />
                <span class="hidden text-[13px] text-on-dark-muted sm:inline">پنل مدیریت</span>
            </a>
            <div class="flex items-center gap-2">
                <a href="/" target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-1.5 rounded-lg px-3 text-[13px] text-on-dark-muted transition-colors hover:text-white">
                    دیدن سایت
                    <span aria-hidden="true" class="text-[11px]">↗</span>
                </a>
                @if (authed)
                {
                    <form method="post" asp-page="/Admin/Login" asp-page-handler="Logout">
                        <button type="submit" class="inline-flex min-h-11 items-center rounded-lg border border-white/12 px-3 text-[13px] text-on-dark transition-colors hover:bg-white/10">خروج</button>
                    </form>
                }
            </div>
        </div>
    </header>

    @if (authed)
    {
        <nav aria-label="بخش‌های پنل" class="sticky top-0 z-40 border-b border-hairline bg-card">
            <div class="relative mx-auto max-w-5xl px-4 sm:px-6">
                <partial name="_AdminNav" model="@(new AdminNavModel(available, activeTab, path == "/admin", path.StartsWith("/admin/leads")))" />
                @* محو‌شدگی لبه‌ی چپ: در عرض‌های کم که نوار اسکرول می‌شود، نشان
                   می‌دهد ادامه دارد. جایی که اسکرول لازم نیست، روی زمینه‌ی
                   خالی می‌افتد و دیده نمی‌شود. *@
                <span aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-0 w-10 bg-gradient-to-l from-transparent to-card"></span>
            </div>
        </nav>
    }

    @* اسکیپ‌لینکِ لایوت ریشه به #main می‌رود، پس پنل هم باید همین لنگر را
       داشته باشد وگرنه آن لینک این‌جا به جایی نمی‌رسد. *@
    <main id="main" class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-10">
        @RenderBody()
    </main>
</div>
