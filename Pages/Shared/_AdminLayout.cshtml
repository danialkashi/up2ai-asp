@using System.Text.Json.Nodes
@using Up2Ai.Services
@inject Up2Ai.Services.ContentStore Store
@{
    // پوسته‌ی پنل مدیریت.
    //
    // پنل عمداً روشن است و هرگز نباید در نتایج جست‌وجو بیاید: متای noindex
    // را لایوت اصلی از روی ViewData["NoIndex"] می‌گذارد، و کنارش مسیر
    // /admin در robots.txt هم مسدود است.
    //
    // ناوبری: نسخه‌ی قبلی یک نوار تب افقی با سیزده تب بود که روی هر عرضی
    // می‌شکست و خواندنش سخت بود. حالا فهرست بخش‌ها در ستون کناری و
    // *گروه‌بندی‌شده* است — پس هم جا برای نام کامل هست، هم معلوم است هر
    // بخش به کدام قسمت سایت مربوط می‌شود. روی موبایل همان فهرست داخل یک
    // منوی تاشو می‌آید (بدون جاوااسکریپت، با <details>).
    Layout = "_Layout";
    var c = (Cv)ViewData["Content"]!;
    var authed = ViewData["Authed"] as bool? ?? false;
    ViewData["Title"] = "پنل مدیریت";

    // فهرست بخش‌ها از خودِ شکل محتوا می‌آید، نه از یک لیست دستی — پس بخش
    // تازه‌ی محتوا خودکار در ناوبری هم پیدا می‌شود.
    var available = Store.Defaults is JsonObject defs ? defs.Select(p => p.Key).ToList() : new List<string>();
    var path = (Context.Request.Path.Value ?? "").TrimEnd('/').ToLowerInvariant();
    var activeTab = ViewData["ActiveTab"] as string ?? "";
    var onLeads = path.StartsWith("/admin/leads");
    var onHome = path == "/admin";

    // عنوانی که در دکمه‌ی منوی موبایل نشان داده می‌شود
    var currentTitle = onLeads ? "صندوق لید"
        : onHome ? "خانه‌ی پنل"
        : activeTab.Length > 0 ? AdminLabels.MetaFor(activeTab).Title
        : "پنل مدیریت";
}

<div class="min-h-screen bg-surface">
    <header class="border-b border-hairline bg-ink">
        <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6">
            <a href="/admin" class="-my-2 flex min-h-11 items-center gap-3 py-2">
                <partial name="_Logo" model="@(("light", "h-6 w-auto"))" />
                <span class="hidden text-[13px] text-on-dark-muted sm:inline">پنل مدیریت</span>
            </a>
            <div class="flex items-center gap-2">
                <a href="/" target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-1.5 rounded-lg px-3 text-[13px] text-on-dark-muted transition-colors hover:text-white">
                    دیدن سایت
                    <span aria-hidden="true" class="text-[11px]">↗</span>
                </a>
                @if (authed)
                {
                    <form method="post" asp-page="/Admin/Login" asp-page-handler="Logout">
                        <button type="submit" class="inline-flex min-h-11 items-center rounded-lg border border-white/12 px-3 text-[13px] text-on-dark transition-colors hover:bg-white/10">خروج</button>
                    </form>
                }
            </div>
        </div>
    </header>

    @* ستون‌بندی فقط وقتی معنی دارد که ستون کناری هست. صفحه‌ی ورود سایدبار
       ندارد، و اگر گرید بماند، خودِ فرمِ ورود در ستون ۱۵rem می‌افتد. *@
    <div class="mx-auto max-w-6xl gap-8 px-4 py-6 sm:px-6 lg:py-10 @(authed ? "lg:grid lg:grid-cols-[15rem_minmax(0,1fr)]" : "")">
        @if (authed)
        {
            @* ---------------- منوی موبایل: همان فهرست، تاشو ---------------- *@
            <details class="mb-6 rounded-xl border border-hairline bg-card lg:hidden">
                <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-[14px] font-medium text-on-light">
                    <span>
                        <span class="text-[12px] font-normal text-on-light-muted">الان این‌جایی:</span>
                        @currentTitle
                    </span>
                    <span aria-hidden="true" class="text-[12px] text-on-light-muted">تغییر بخش ▾</span>
                </summary>
                <nav aria-label="بخش‌های پنل" class="border-t border-hairline px-2 py-2">
                    <partial name="_AdminNav" model="@(new AdminNavModel(available, activeTab, onHome, onLeads))" />
                </nav>
            </details>

            @* -------------------- سایدبار دسکتاپ -------------------- *@
            <aside class="hidden lg:block">
                <nav aria-label="بخش‌های پنل" class="sticky top-6 flex flex-col gap-1">
                    <partial name="_AdminNav" model="@(new AdminNavModel(available, activeTab, onHome, onLeads))" />
                </nav>
            </aside>
        }

        @* اسکیپ‌لینکِ لایوت ریشه به #main می‌رود، پس پنل هم باید همین لنگر را
           داشته باشد وگرنه آن لینک این‌جا به جایی نمی‌رسد. *@
        <main id="main" class="min-w-0 @(authed ? "" : "mx-auto max-w-2xl")">
            @RenderBody()
        </main>
    </div>
</div>
