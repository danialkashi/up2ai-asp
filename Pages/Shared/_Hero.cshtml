@{
    var c = (Cv)ViewData["Content"]!;
    var hero = c["copy"]["hero"];
    var site = c["site"];
}
@* هدر sticky است، پس ارتفاع هیرو باید ارتفاع هدر را کم کند تا مجموع دقیقاً
   یک صفحه شود و اسکرول اضافه ایجاد نکند. پس‌زمینه‌ی خودِ سکشن روشن است؛
   لایه‌ی تیره روی آن می‌نشیند و در نوار پایانی با ماسک محو می‌شود. *@
<section id="top" class="relative -mt-[var(--header-h)] overflow-hidden bg-surface-2 pt-[var(--header-h)]">
    @* کل لایه‌ی تیره (زمینه + هاله‌ها) یک واحد است و با `mask-image` (کلاس
       `hero-dark` در CSS) در پایین محو می‌شود تا روشنیِ سکشن از زیرش بیرون بزند. *@
    <div class="hero-dark pointer-events-none absolute inset-0" aria-hidden="true"><div class="absolute inset-0 bg-ink"></div><div class="absolute -top-48 right-[-12%] h-[620px] w-[620px] rounded-full blur-[140px]" style="background:radial-gradient(circle, rgba(99,102,241,0.26), transparent 68%)"></div><div class="absolute bottom-[-18%] left-[-18%] h-[640px] w-[640px] rounded-full blur-[140px]" style="background:radial-gradient(circle, rgba(168,85,247,0.20), transparent 68%)"></div></div>
    @* رنگ‌دادن ملایم به خودِ نوار گذار — بدون این، میانه‌ی محوشدن خاکستری کدر می‌شود. *@
    <div class="hero-seam pointer-events-none absolute inset-x-0 bottom-0" aria-hidden="true"></div>
    @* padding پایین باید از طول نوار گذار بیشتر باشد وگرنه ردیف اعتماد داخل
       ناحیه‌ی روشن‌شونده می‌افتد و کنتراستش می‌شکند. *@
    <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 pb-48 pt-12 sm:px-6 sm:pb-64 sm:pt-16 lg:grid-cols-[1.05fr_1fr] lg:gap-10 lg:pb-72 lg:pt-20">
        @* ستون متن *@
        <div class="text-center lg:text-start">
            <div class="inline-flex" data-anim="rise" style="animation-delay:0ms"><span class="inline-flex items-center gap-2 rounded-full border border-white/12 bg-white/[0.04] px-3.5 py-1.5 text-[13px] font-medium text-on-dark/80 backdrop-blur-sm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="h-4 w-4 text-brand-soft"><path d="M12 3.2 13.7 8c.2.6.7 1.1 1.3 1.3l4.8 1.7-4.8 1.7c-.6.2-1.1.7-1.3 1.3L12 18.8 10.3 14c-.2-.6-.7-1.1-1.3-1.3L4.2 11l4.8-1.7c.6-.2 1.1-.7 1.3-1.3L12 3.2Z"></path></svg>@hero["badge"]</span></div>
            <h1 class="mt-6 text-[2rem] font-bold leading-[1.35] tracking-tight text-white sm:text-[2.75rem] lg:text-[3.25rem]" data-anim="rise" style="animation-delay:80ms"><span class="block">@hero["headlineLine1"]</span><span class="block text-gradient">@hero["headlineLine2"]</span></h1>
            <p class="mx-auto mt-5 max-w-xl text-[15px] leading-[2] text-on-dark-muted sm:text-[17px] lg:mx-0" data-anim="rise" style="animation-delay:160ms">@hero["lead"]</p>
            <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:justify-start" data-anim="rise" style="animation-delay:240ms"><a href="@site["cta"]["href"]" class="group inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-gradient-to-l from-brand-deep to-brand-2-deep px-6 py-3.5 text-[15px] font-medium text-white shadow-[0_10px_30px_-8px_rgba(99,102,241,0.75)] transition-transform duration-200 hover:-translate-y-0.5 sm:w-auto">@site["cta"]["label"]<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="h-[18px] w-[18px] transition-transform duration-200 group-hover:-translate-x-1"><path d="M19 12H5"></path><path d="m11 6-6 6 6 6"></path></svg></a><a href="@hero["secondaryCtaHref"]" class="inline-flex w-full items-center justify-center rounded-2xl border border-white/14 bg-white/[0.03] px-6 py-3.5 text-[15px] font-medium text-on-dark backdrop-blur-sm transition-colors duration-200 hover:bg-white/[0.08] sm:w-auto">@hero["secondaryCta"]</a></div>
            <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-5 gap-y-2.5 text-[13px] text-on-dark-muted lg:justify-start" data-anim="rise" style="animation-delay:320ms">@foreach (var t in hero["trust"]){<li class="inline-flex items-center gap-1.5"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="h-3.5 w-3.5 text-brand-soft"><path d="m4.5 12.5 4.5 4.5L19.5 6.5"></path></svg>@t</li>}</ul>
        </div>
        @* ستون بصری *@
        <div class="mt-2 lg:mt-0" data-anim="zoom" style="--pv-from:0.94;animation-duration:.7s;animation-delay:100ms">
            <partial name="_OrbitVisual" />
        </div>
    </div>
</section>
