@page
@model ErrorModel
@{
    // صفحه‌ی خطا و صفحه‌ی «پیدا نشد»، هر دو از همین ویو.
    //
    // متنِ ۴۰۴ از محتوا می‌آید (`copy.notFound`) — همان متنی که پنل مدیریت
    // زیر عنوان «صفحه‌ی ۴۰۴» به کاربر نشان می‌دهد و می‌گوید «چیزی که وقتی
    // آدرس اشتباه باز شود دیده می‌شود». قبل از این، آن وعده دروغ بود: نه
    // صفحه‌ی ۴۰۴ای وجود داشت و نه `UseStatusCodePages`ای، پس آدرسِ اشتباه یک
    // پاسخِ کاملاً خالی می‌گرفت و آن متن هیچ‌جا خوانده نمی‌شد.
    var c = ViewData["Content"] as Cv? ?? new Cv(null);
    var nf = c["copy"]["notFound"];
    var site = c["site"];

    // هر متن یک جای‌گزینِ ثابت هم دارد: اگر خودِ خواندنِ محتوا شکست خورده
    // باشد (که کاملاً ممکن است — شاید همان دلیلِ رسیدن به این صفحه است)،
    // مقدارها خالی برمی‌گردند و صفحه نباید بی‌متن رندر شود.
    string Or(string value, string fallback) => value.Length > 0 ? value : fallback;

    var heading = Model.IsNotFound
        ? Or(nf["heading"].S, "این صفحه وجود ندارد")
        : "مشکلی پیش آمد";
    var lead = Model.IsNotFound
        ? Or(nf["lead"].S, "احتمالاً آدرس تغییر کرده یا لینکی که دنبالش بوده‌اید قدیمی است.")
        : "خطایی سمت سرور رخ داد. اگر دوباره تکرار شد، لطفاً خبرمان کنید.";
    var code = Model.IsNotFound ? Or(nf["code"].S, "۴۰۴") : "۵۰۰";

    ViewData["Title"] = $"{(Model.IsNotFound ? Or(nf["title"].S, "صفحه پیدا نشد") : "خطا")} — {Or(site["name"].S, "UP2AI")}";
}

<section class="flex flex-1 items-center bg-surface">
    <div class="mx-auto w-full max-w-2xl px-4 py-24 text-center sm:px-6 sm:py-32">
        <span class="inline-flex items-center rounded-full border border-brand/20 bg-brand/[0.06] px-4 py-1.5 text-[15px] font-bold text-brand-ink">@code</span>
        <h1 class="mt-6 text-[1.75rem] font-bold leading-[1.45] tracking-tight text-on-light sm:text-[2.25rem]">@heading</h1>
        <p class="mx-auto mt-4 max-w-prose text-[15px] leading-[2] text-on-light-muted sm:text-[16px]">@lead</p>

        <a href="/" class="mt-8 inline-flex min-h-11 items-center justify-center rounded-2xl bg-gradient-to-l from-brand-deep to-brand-2-deep px-6 py-3.5 text-[15px] font-medium text-white shadow-[0_10px_30px_-10px_rgba(99,102,241,0.7)] transition-transform duration-200 hover:-translate-y-0.5">@(nf["home"].HasText ? nf["home"].S : "برگشت به صفحه‌ی اصلی")</a>

        @* شناسه‌ی درخواست فقط برای خطای سرور معنا دارد — برای پیگیری در لاگ.
           روی ۴۰۴ نشان داده نمی‌شود چون چیزی برای پیگیری نیست. *@
        @if (!Model.IsNotFound && Model.ShowRequestId)
        {
            <p class="mt-8 text-[12.5px] text-on-light-muted">
                شناسه‌ی پیگیری: <code dir="ltr" class="rounded bg-surface-2 px-1.5 py-0.5">@Model.RequestId</code>
            </p>
        }
    </div>
</section>
