@{
    // ────────────────────────────────────────────────────────────────────
    // پورت `AgentDemo` از AgentDemo.tsx.
    //
    // این کامپوننت در نسخه‌ی ری‌اکت state داشت (تب فعال، پخش دوباره،
    // شروع انیمیشن با IntersectionObserver). طبق بند ۶ قرارداد، این‌جا فقط
    // مارک‌آپِ حالت اولیه رندر می‌شود — یعنی همان چیزی که سرور می‌داد:
    // سناریوی شماره‌ی صفر انتخاب‌شده. بقیه‌ی کار با جاوااسکریپت سایت است و
    // این‌ها قلاب‌هایی است که آن اسکریپت با آن‌ها کار می‌کند:
    //
    //   #demo                          ریشه‌ی بخش
    //   [role="tab"]                   دکمه‌های تب (به‌ترتیب سناریوها)
    //   ul[class*="flex-col"]          فهرست گفت‌وگو
    //   ol                             فهرست اقدام‌های پشت صحنه
    //   [role="tabpanel"] span         اسپن کانال (آخرین فرزندش متنِ کانال است)
    //   button:not([role="tab"])       دکمه‌ی «پخش دوباره»
    //   ol → parentElement → p         متن نتیجه
    //
    // هشدار: ترتیب و شکل بالا را عوض نکن؛ اسکریپت دقیقاً همین‌ها را
    // query می‌کند. مثلاً اگر پیش از ul گفت‌وگو یک ul دیگر اضافه شود،
    // یا دکمه‌ی دیگری قبل از «پخش دوباره» بیاید، دمو از کار می‌افتد.
    // ────────────────────────────────────────────────────────────────────
    var c = (Cv)ViewData["Content"]!;
    var demoCopy = c["copy"]["demo"];
    var scenarios = c["demo"]["scenarios"];
    var scenario = scenarios[0];
    var panelId = scenario["id"].S;
    // فاصله‌ی نمایش هر پیام از پیام قبلی (میلی‌ثانیه) — همان ثابت STEP در TSX.
    const int STEP = 620;
}
@* اولین بخش بعد از هیرو است، پس `surface-landing` را می‌گیرد تا ادامه‌ی
   نوار گذارِ تیره‌به‌روشن باشد. *@
<section id="demo" class="surface-landing border-b border-hairline bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24 lg:py-28">
        <div class="max-w-2xl"><span class="inline-flex items-center rounded-full border border-brand/20 bg-brand/[0.06] px-3 py-1 text-[13px] font-medium text-brand-ink">@demoCopy["eyebrow"]</span><h2 class="mt-5 text-[1.75rem] font-bold leading-[1.45] tracking-tight text-on-light sm:text-[2.25rem]">@demoCopy["heading"]</h2><p class="mt-4 text-[15px] leading-[2] text-on-light-muted sm:text-[16px]">@demoCopy["lead"]</p></div>
        @* انتخاب سناریو *@
        @* روی موبایل ستونی و تمام‌عرض (هر تب یک هدفِ لمسیِ کامل)، از sm به
           بالا همان ردیفِ افقیِ قبلی. با flex-wrapِ تنها، سه تب در عرضِ کم
           دو ردیفِ نامرتب می‌ساختند و هیچ‌کدام لبه‌ها را پر نمی‌کرد. *@
        <div class="mt-8 flex flex-col gap-2 sm:flex-row sm:flex-wrap" role="tablist" aria-label="@demoCopy["tabsAria"]">@{ var ti = 0; }@foreach (var s in scenarios)
            {
                var on = ti == 0;
                ti++;
                var sid = s["id"].S;
                var sel = on ? "true" : "false";
                var icon = s["icon"].S;
                var tabClass = "inline-flex w-full items-center justify-center gap-2 rounded-xl border px-4 py-[11px] text-[14px] font-medium transition-colors duration-200 sm:w-auto sm:justify-start "
                    + (on
                        ? "border-brand/35 bg-card text-brand-ink shadow-[0_6px_20px_-12px_rgba(99,102,241,0.55)]"
                        : "border-hairline bg-transparent text-on-light-muted hover:bg-card hover:text-on-light");
                <button type="button" role="tab" id="demo-tab-@sid" aria-selected="@sel" aria-controls="demo-panel-@sid" tabindex="@(on ? 0 : -1)" class="@tabClass">@if (icon == "instagram")
                    {<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="h-[18px] w-[18px]"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"></circle></svg>}
                    else if (icon == "trend")
                    {<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="h-[18px] w-[18px]"><path d="M3 17.5 9 11l4 4 7.5-8"></path><path d="M15.5 3.5H21V9"></path></svg>}
                    else if (icon == "chat")
                    {<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="h-[18px] w-[18px]"><path d="M20.5 12.4c0 4-3.8 7.2-8.5 7.2-.9 0-1.8-.1-2.6-.3L4 21l1.3-3.6c-1.1-1.2-1.8-2.8-1.8-4.5 0-4 3.8-7.2 8.5-7.2s8.5 3.2 8.5 7.2Z"></path><path d="M8.8 12.4h.01M12 12.4h.01M15.2 12.4h.01" stroke-width="2.4"></path></svg>}@s["tab"]</button>
            }</div>
        @* tabindex="0" لازم است چون محتوای پنل خودش عنصرِ فوکوس‌پذیر ندارد؛
           بدون آن، کاربرِ صفحه‌کلید بعد از نوار تب مستقیم از روی پنل رد می‌شود.
           شناسه‌ی پنل را جاوااسکریپت همراه تبِ فعال عوض می‌کند (سرور فقط
           سناریوی اول را رندر می‌کند، پس فقط یک پنل در صفحه هست). *@
        <div id="demo-panel-@panelId" role="tabpanel" tabindex="0" aria-labelledby="demo-tab-@panelId" class="mt-5 grid gap-4 lg:grid-cols-[1.1fr_1fr]">
            @* گفت‌وگو *@
            <div class="flex flex-col rounded-2xl border border-hairline bg-card p-5 sm:p-6">
                <div class="flex items-center justify-between gap-3 border-b border-hairline pb-4"><span class="inline-flex items-center gap-2 text-[13px] font-medium text-on-light-muted"><span aria-hidden="true" class="inline-block h-2 w-2 rounded-full bg-emerald-500"></span>@scenario["channel"]</span><button type="button" class="-me-2 inline-flex min-h-11 items-center gap-1.5 rounded-lg px-3 py-2 text-[13px] text-on-light-muted transition-colors hover:bg-surface-2 hover:text-on-light"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="h-[15px] w-[15px]"><path d="M3.5 12a8.5 8.5 0 1 0 2.6-6.1"></path><path d="M3 4v5h5"></path></svg>@demoCopy["replay"]</button></div>
                <ul class="mt-4 flex flex-col gap-3">@{ var ci = 0; }@foreach (var line in scenario["chat"])
                    {
                        var side = line["from"].S == "agent"
                            ? "self-end bg-brand/[0.07] text-on-light"
                            : "self-start bg-surface-2 text-on-light";
                        var delay = ci * STEP;
                        ci++;
                        <li data-demo="in" style="animation-delay:@(delay)ms" class="max-w-[85%] rounded-2xl px-4 py-2.5 text-[14px] leading-[1.9] @side">@line["text"]</li>
                    }</ul>
            </div>
            @* اقدام‌های پشت صحنه — پنل عمداً تیره است (`bg-ink`) تا از کارت
               گفت‌وگو جدا دیده شود. این را روشن نکن. *@
            <div class="flex flex-col rounded-2xl bg-ink p-5 sm:p-6">
                <h3 class="border-b border-white/10 pb-4 text-[13px] font-medium text-on-dark-muted">@demoCopy["behindHeading"]</h3>
                <ol class="my-auto flex flex-col gap-3.5 py-6">@{ var ai = 0; }@foreach (var a in scenario["actions"])
                    {
                        var delay = ai * STEP + (int)(STEP * 0.55);
                        ai++;
                        <li data-demo="in" style="animation-delay:@(delay)ms" class="flex gap-3 text-[13.5px] leading-[1.85] text-on-dark"><span aria-hidden="true" class="mt-[7px] inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-brand-soft"></span><span>@a</span></li>
                    }</ol>
                <p class="border-t border-white/10 pt-5 text-[13px] leading-[1.9] text-on-dark-muted">@scenario["outcome"]</p>
            </div>
        </div>
        <p class="mt-5 text-[13px] leading-[1.9] text-on-light-muted">@demoCopy["disclaimer"]</p>
    </div>
</section>
