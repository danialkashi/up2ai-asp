@{
    // ────────────────────────────────────────────────────────────────────
    // فوتر — پورت Footer.tsx.
    //
    // جای نمادهای اینماد و ساماندهی از همین حالا در نظر گرفته شده ولی
    // به‌صورت جای‌خالیِ صریح — نه یک تصویر جعلی. نماد که گرفته شد فقط باید
    // فایلش را جایگزین کرد؛ چیدمان تکان نمی‌خورد چون ابعاد جای‌خالی همان
    // ابعاد نماد واقعی است.
    //
    // بلوک شبکه‌های اجتماعی و سطر ایمیل هر دو مشروط‌اند — دقیقاً مثل نسخه‌ی
    // React. با defaults.json فعلی (contact خالی) هیچ‌کدام رندر نمی‌شوند و
    // خروجی با /tmp/ref/home.html یکی است.
    //
    // این کامپوننت هیچ رفتار تعاملی‌ای ندارد؛ نه state، نه قلاب جاوااسکریپت.
    // ────────────────────────────────────────────────────────────────────
    var c = (Cv)ViewData["Content"]!;
    var site = c["site"];
    var nav = c["navItems"];
    var contact = c["contact"];
    var f = c["copy"]["footer"];

    // مثل هدر: لنگرها بیرون از صفحه‌ی اصلی باید اول به خانه برگردند.
    var here = Context.Request.Path.Value;
    var ctaHref = SiteLinks.Resolve(site["cta"]["href"].S, here);
    var igLabel = f["social"]["instagram"].S;
    var tgLabel = f["social"]["telegram"].S;
    var waLabel = f["social"]["whatsapp"].S;

    var igHref = $"https://instagram.com/{contact["instagram"]}";
    var tgHref = $"https://t.me/{contact["telegram"]}";
    var waHref = $"https://wa.me/{contact["whatsapp"]}";
    var mailtoHref = $"mailto:{contact["email"]}";

    var hasSocial = contact["instagram"].HasText
                    || contact["telegram"].HasText
                    || contact["whatsapp"].HasText;

    // معادل fill() از src/lib/copy.ts — فقط همان دو جای‌گیرِ این متن.
    //
    // سال دیگر از محتوا خوانده نمی‌شود، از تاریخِ همین لحظه حساب می‌شود:
    // قبلاً «۱۴۰۴» یک رشته‌ی ثابت در defaults.json بود و سرِ تحویل سال باید
    // یادت می‌ماند دستی عوضش کنی، وگرنه پاورقی سالِ گذشته را نشان می‌داد.
    // تقویم هجری شمسی است (PersianCalendar خودِ .NET) و رقم‌ها هم فارسی
    // چاپ می‌شوند تا با بقیه‌ی متنِ صفحه یکدست بماند.
    var copyright = f["copyright"].S
        .Replace("{year}", PersianYear.Now())
        .Replace("{name}", site["name"].S);
}<footer class="bg-ink">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16">
        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr]">
            @* برند *@
            <div>
                <partial name="_Logo" model="@(("light", "h-7 w-auto"))" />
                <p class="mt-4 max-w-xs text-[14px] leading-[2] text-on-dark-muted">@site["description"]</p>
                @if (hasSocial)
                {
                    <ul class="mt-6 flex gap-2">
                        @if (contact["instagram"].HasText)
                        {
                            <li>
                                <a href="@igHref" target="_blank" rel="noopener noreferrer" aria-label="@igLabel" class="grid h-11 w-11 place-items-center rounded-xl border border-white/12 bg-white/[0.04] text-on-dark transition-colors hover:bg-white/[0.09]">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="h-[18px] w-[18px]"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"></circle></svg>
                                </a>
                            </li>
                        }
                        @if (contact["telegram"].HasText)
                        {
                            <li>
                                <a href="@tgHref" target="_blank" rel="noopener noreferrer" aria-label="@tgLabel" class="grid h-11 w-11 place-items-center rounded-xl border border-white/12 bg-white/[0.04] text-on-dark transition-colors hover:bg-white/[0.09]">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="h-[18px] w-[18px]"><path d="M21 4.5 2.9 11.3c-.7.3-.7 1.3.1 1.5l4.6 1.4 1.8 5c.2.6 1 .8 1.4.3l2.4-2.6 4.6 3.4c.6.4 1.4.1 1.6-.6L21.8 5.6c.2-.8-.6-1.4-1.3-1.1Z"></path><path d="m7.6 14.2 10.6-7.4-6.4 8.5"></path></svg>
                                </a>
                            </li>
                        }
                        @if (contact["whatsapp"].HasText)
                        {
                            <li>
                                <a href="@waHref" target="_blank" rel="noopener noreferrer" aria-label="@waLabel" class="grid h-11 w-11 place-items-center rounded-xl border border-white/12 bg-white/[0.04] text-on-dark transition-colors hover:bg-white/[0.09]">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="h-[18px] w-[18px]"><path d="M3.5 20.5 4.8 16A8.2 8.2 0 1 1 8 19.2l-4.5 1.3Z"></path><path d="M9 8.6c.3-.1.6 0 .8.3l.7 1.2c.2.3.1.6-.1.8l-.5.5c-.2.2-.2.4-.1.6.4.8 1.2 1.6 2 2 .2.1.4 0 .6-.1l.5-.5c.2-.2.5-.3.8-.1l1.2.7c.3.2.4.5.3.8-.2.7-.9 1.2-1.7 1.2-2.6 0-5.6-3-5.6-5.6 0-.8.4-1.5 1.1-1.8Z"></path></svg>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </div>

            @* پیمایش *@
            <nav aria-label="@f["navAria"]">
                <h2 class="text-[14px] font-bold text-white">@f["navHeading"]</h2>
                <ul class="mt-4 flex flex-col gap-1">
                    @foreach (var item in nav)
                    {
                        <li><a href="@SiteLinks.Resolve(item["href"].S, here)" class="-mx-2 inline-flex min-h-11 items-center rounded-lg px-2 text-[14px] text-on-dark-muted transition-colors hover:text-white">@item["label"]</a></li>
                    }
                </ul>
            </nav>

            @* تماس *@
            <div>
                <h2 class="text-[14px] font-bold text-white">@f["contactHeading"]</h2>
                <ul class="mt-4 flex flex-col gap-1">
                    @if (contact["email"].HasText)
                    {
                        <li><a href="@mailtoHref" dir="ltr" class="-mx-2 inline-flex min-h-11 items-center rounded-lg px-2 text-[14px] text-on-dark-muted transition-colors hover:text-white">@contact["email"]</a></li>
                    }
                    <li><a href="@ctaHref" class="-mx-2 inline-flex min-h-11 items-center rounded-lg px-2 text-[14px] text-on-dark-muted transition-colors hover:text-white">@site["cta"]["label"]</a></li>
                </ul>
            </div>
        </div>

        @* کپی‌رایت.

           جای‌خالیِ نمادهای اینماد و ساماندهی از این‌جا برداشته شد: سایت
           فروش و پرداخت آنلاین ندارد، پس اینماد موضوعیت ندارد، و آن دو کادرِ
           خط‌چینِ خالی فقط فضای پاورقی را می‌گرفتند بدون این‌که چیزی بگویند.
           نماد که گرفته شد، همین‌جا کنار کپی‌رایت جای کافی برایش هست. *@
        <div class="mt-12 border-t border-white/10 pt-8">
            <p class="text-[13px] text-on-dark-muted">@copyright</p>
        </div>
    </div>
</footer>