@model Up2Ai.Services.AdminNavModel
@using Up2Ai.Services
@{
    // نوار تب‌های پنل — یک ردیف افقی، همیشه یک خط.
    //
    // نسخه‌ی اول این نوار می‌شکست چون تب‌ها flex-item بودند و اجازه داشتند
    // جمع شوند؛ متنِ داخلشان سه خط می‌شد. کلید حل: `shrink-0` روی هر تب،
    // و اسکرول افقیِ خودِ ردیف. اسم‌های کوتاه (AdminLabels.Short) هم برای
    // همین است که در عرض معمول اصلاً نیازی به اسکرول نشود.
    //
    // بین گروه‌ها یک خط جداکننده هست تا سه دسته‌ی «پایه / بخش‌های صفحه /
    // متن‌ها» بدون اشغال فضای اضافه از هم تفکیک شوند.
}

@functions {
    string TabClass(bool on) =>
        "inline-flex min-h-11 shrink-0 items-center whitespace-nowrap border-b-2 px-3 text-[13.5px] font-medium transition-colors "
        + (on
            ? "border-brand text-brand-ink"
            : "border-transparent text-on-light-muted hover:text-on-light");
}

<ul class="no-scrollbar -mb-px flex items-stretch gap-0.5 overflow-x-auto">
    <li class="shrink-0">
        <a href="/admin" aria-current="@(Model.OnHome ? "page" : null)" class="@TabClass(Model.OnHome)">خانه‌ی پنل</a>
    </li>

    @foreach (var group in AdminLabels.Groups)
    {
        var keys = AdminLabels.SectionsInGroup(group.Key, Model.Available).ToList();
        if (keys.Count == 0) { continue; }

        <li aria-hidden="true" class="flex shrink-0 items-center px-1.5"><span class="h-4 w-px bg-hairline"></span></li>
        foreach (var key in keys)
        {
            var meta = AdminLabels.MetaFor(key);
            var on = Model.ActiveTab == key;
            <li class="shrink-0">
                <a href="/admin/@key" title="@meta.Title" aria-current="@(on ? "page" : null)" class="@TabClass(on)">@meta.TabTitle</a>
            </li>
        }
    }

    <li aria-hidden="true" class="flex shrink-0 items-center px-1.5"><span class="h-4 w-px bg-hairline"></span></li>
    <li class="shrink-0">
        <a href="/admin/leads" aria-current="@(Model.OnLeads ? "page" : null)" class="@TabClass(Model.OnLeads)">صندوق لید</a>
    </li>
</ul>
