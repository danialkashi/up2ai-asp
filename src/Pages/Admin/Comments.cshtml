@page "/admin/comments"
@model Up2Ai.Pages.Admin.CommentsModel
@using Up2Ai.Services
@{ Layout = "_AdminLayout"; }

<div class="flex flex-col gap-6">
    <div>
        <h1 class="text-[24px] font-bold text-on-light">نظرها</h1>
        <p class="mt-2 max-w-prose text-[14px] leading-[2] text-on-light-muted">
            هیچ نظری بدون تأیید تو روی سایت نمی‌رود. فرستنده بلافاصله پیام
            «بعد از بررسی منتشر می‌شود» را می‌بیند، پس منتظر نمی‌ماند.
        </p>
    </div>

    @if (Model.Notice is not null)
    {
        <p role="status" class="rounded-xl border border-brand/25 bg-brand/[0.05] px-4 py-3 text-[13.5px] text-on-light">@Model.Notice</p>
    }

    <div class="flex items-center gap-2 text-[13px]">
        <a href="/admin/comments" class="inline-flex min-h-11 items-center rounded-lg px-3 font-medium transition-colors @(Model.OnlyPending ? "bg-brand/10 text-brand-ink" : "text-on-light-muted hover:text-on-light")">منتظر تأیید (@PersianYear.ToPersianDigits(Model.PendingCount.ToString()))</a>
        <a href="/admin/comments?filter=all" class="inline-flex min-h-11 items-center rounded-lg px-3 font-medium transition-colors @(!Model.OnlyPending ? "bg-brand/10 text-brand-ink" : "text-on-light-muted hover:text-on-light")">همه (@PersianYear.ToPersianDigits(Model.TotalCount.ToString()))</a>
    </div>

    @if (Model.Comments.Count == 0)
    {
        <div class="rounded-2xl border border-dashed border-hairline bg-card px-5 py-10 text-center text-[14px] leading-[2] text-on-light-muted">
            @(Model.OnlyPending ? "نظرِ منتظرِ تأییدی نیست." : "هنوز نظری ثبت نشده.")
        </div>
    }
    else
    {
        <ul class="flex flex-col gap-3">
            @foreach (var comment in Model.Comments)
            {
                var post = Model.PostsById.GetValueOrDefault(comment.PostId);
                <li class="rounded-2xl border bg-card p-5 @(comment.Approved ? "border-hairline" : "border-amber-300")">
                    <div class="flex flex-wrap items-start justify-between gap-3">
                        <div class="min-w-0">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="text-[15px] font-bold text-on-light">@comment.Name</span>
                                @if (comment.Approved)
                                {
                                    <span class="rounded-md bg-emerald-100 px-2 py-0.5 text-[11px] font-medium text-emerald-800">منتشرشده</span>
                                }
                                else
                                {
                                    <span class="rounded-md bg-amber-100 px-2 py-0.5 text-[11px] font-medium text-amber-900">منتظر تأیید</span>
                                }
                            </div>
                            <p class="mt-1 text-[12.5px] text-on-light-muted">
                                روی نوشته‌ی:
                                @if (post is not null)
                                {
                                    <a href="/admin/posts/edit?id=@post.Id" class="text-brand-ink underline underline-offset-4">@post.Title</a>
                                }
                                else
                                {
                                    <span>(نوشته حذف شده)</span>
                                }
                            </p>
                        </div>
                        <span class="shrink-0 text-[12.5px] text-on-light-muted">@PersianYear.FormatDate(comment.At)</span>
                    </div>

                    <p class="mt-3 whitespace-pre-wrap text-[14px] leading-[1.95] text-on-light">@comment.Body</p>

                    <div class="mt-4 flex flex-wrap items-center gap-2">
                        <form method="post" asp-page-handler="Approve">
                            <input type="hidden" name="id" value="@comment.Id" />
                            <input type="hidden" name="approved" value="@((!comment.Approved).ToString().ToLowerInvariant())" />
                            <input type="hidden" name="filter" value="@Model.Filter" />
                            <button type="submit" class="inline-flex min-h-11 items-center rounded-lg border border-hairline px-3 text-[13px] font-medium text-on-light transition-colors hover:border-brand/35">@(comment.Approved ? "برداشتن از سایت" : "تأیید و انتشار")</button>
                        </form>

                        @if (post is not null && post.Published)
                        {
                            <a href="/blog/@Uri.EscapeDataString(post.Slug)#comments" target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-1.5 rounded-lg border border-hairline px-3 text-[13px] font-medium text-on-light transition-colors hover:border-brand/35">دیدن روی سایت<span aria-hidden="true" class="text-[11px]">↗</span></a>
                        }

                        <form method="post" asp-page-handler="Delete">
                            <input type="hidden" name="id" value="@comment.Id" />
                            <input type="hidden" name="filter" value="@Model.Filter" />
                            <button type="submit" class="inline-flex min-h-11 items-center rounded-lg px-3 text-[13px] text-on-light-muted transition-colors hover:text-red-700">حذف</button>
                        </form>
                    </div>
                </li>
            }
        </ul>
    }
</div>
