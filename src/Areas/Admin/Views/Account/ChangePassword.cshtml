@model ChangePasswordViewModel

<form method="post" class="mx-auto flex max-w-sm flex-col gap-4 rounded-2xl border border-hairline bg-card p-6 sm:p-8">
    <h1 class="text-[20px] font-bold text-on-light">تغییر رمز</h1>

    <div class="flex flex-col gap-1.5">
        <label for="current-password" class="text-[13px] font-medium text-on-light">رمز فعلی</label>
        <input id="current-password" name="CurrentPassword" type="password" required autofocus autocomplete="current-password"
               aria-invalid="@(Model.Error is not null ? "true" : null)"
               aria-describedby="@(Model.Error is not null ? "change-password-error" : null)"
               class="min-h-11 rounded-xl border border-hairline bg-surface px-3.5 py-2.5 text-[14px] text-on-light outline-none transition-colors focus:border-brand"
               dir="ltr" />
    </div>

    <div class="flex flex-col gap-1.5">
        <label for="new-password" class="text-[13px] font-medium text-on-light">رمز جدید</label>
        <input id="new-password" name="NewPassword" type="password" required autocomplete="new-password"
               class="min-h-11 rounded-xl border border-hairline bg-surface px-3.5 py-2.5 text-[14px] text-on-light outline-none transition-colors focus:border-brand"
               dir="ltr" />
    </div>

    @if (Model.Error is not null)
    {
        <p id="change-password-error" role="alert" class="rounded-xl border border-red-200 bg-red-50 px-3.5 py-2.5 text-[13px] leading-[1.9] text-red-800">@Model.Error</p>
    }

    <button type="submit" class="min-h-11 rounded-xl bg-gradient-to-l from-brand-deep to-brand-2-deep px-5 py-2.5 text-[14px] font-medium text-white disabled:opacity-60">تغییر رمز</button>
    
    @Html.AntiForgeryToken()
</form>
