@model PostEditViewModel
@using Up2Ai.Services
@{
    var fieldCls = "w-full rounded-xl border border-hairline bg-surface px-3.5 py-2.5 text-[14px] text-on-light outline-none transition-colors placeholder:text-on-light-muted focus:border-brand";
}

<link rel="stylesheet" href="/lib/ckeditor5/ckeditor5.css">
<style>
    .ck-editor__editable_inline { min-height: 420px; }
    .ck.ck-editor { border-radius: 0.75rem; }
    /* Tailwind preflight تیترها و فهرست‌ها را بی‌استایل می‌کند؛ داخل ویرایشگر برشان می‌گردانیم. */
    .ck-content { line-height: 2; }
    .ck-content h2 { font-size: 1.5rem; font-weight: 700; margin: 1.5rem 0 .75rem; }
    .ck-content h3 { font-size: 1.2rem; font-weight: 700; margin: 1.25rem 0 .5rem; }
    .ck-content h4 { font-size: 1.05rem; font-weight: 700; margin: 1rem 0 .5rem; }
    .ck-content p { margin: .75rem 0; }
    .ck-content ul { list-style: disc; padding-inline-start: 1.75rem; }
    .ck-content ol { list-style: decimal; padding-inline-start: 1.75rem; }
    .ck-content a { color: #4f46e5; text-decoration: underline; }
</style>


<div class="flex flex-col gap-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="text-[24px] font-bold text-on-light">@(Model.IsNew ? "نوشته‌ی تازه" : "ویرایش نوشته")</h1>
            <p class="mt-2 max-w-prose text-[14px] leading-[2] text-on-light-muted">
                عنوان و متن را پر کن. تا تیکِ «منتشر شود» را نزنی، نوشته فقط
                برای خودت قابل دیدن است و روی سایت و در گوگل نمی‌آید.
            </p>
        </div>
        <a href="/admin/posts" class="inline-flex min-h-11 shrink-0 items-center rounded-xl border border-hairline bg-card px-4 text-[14px] font-medium text-on-light transition-colors hover:border-brand/35">بازگشت به فهرست</a>
    </div>

    @if (Model.Saved is not null)
    {
        <p role="status" class="rounded-xl border border-brand/25 bg-brand/[0.05] px-4 py-3 text-[13.5px] text-on-light">
            @Model.Saved
            @if (Model.SavedPublished && Model.SavedSlug.Length > 0)
            {
                <a href="/blog/@Uri.EscapeDataString(Model.SavedSlug)" target="_blank" rel="noopener" class="ms-2 font-medium text-brand-ink underline underline-offset-4">دیدن روی سایت ↗</a>
            }
        </p>
    }

    @if (Model.Error is not null)
    {
        <p role="alert" class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-[13.5px] text-red-800">@Model.Error</p>
    }

    <form method="post" action="@(Model.IsNew ? "/admin/posts/save" : $"/admin/posts/{Model.Id}/save")" class="flex flex-col gap-5">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />

        <div class="flex flex-col gap-2">
            <label for="title" class="text-[14px] font-medium text-on-light">عنوان</label>
            <input id="title" name="Title" type="text" class="@fieldCls" value="@Model.Title" />
            <p class="text-[12.5px] leading-[1.9] text-on-light-muted">همان چیزی که در نتیجه‌ی گوگل به‌عنوان تیتر آبی دیده می‌شود. کوتاه و مشخص بنویس.</p>
        </div>

        <div class="flex flex-col gap-2">
            <label for="slug" class="text-[14px] font-medium text-on-light">آدرس نوشته</label>
            <input id="slug" name="Slug" type="text" class="@fieldCls" value="@Model.Slug" placeholder="خالی بگذار تا از روی عنوان ساخته شود" />
            <p class="text-[12.5px] leading-[1.9] text-on-light-muted">
                آدرس صفحه: <code class="text-brand-ink" dir="ltr">/blog/@(Model.Slug.Length > 0 ? Model.Slug : "…")</code>
                — اگر خالی باشد از روی عنوان ساخته می‌شود. بعد از انتشار عوضش نکن؛ لینک‌های قبلی می‌شکنند.
            </p>
        </div>

        <div class="flex flex-col gap-2">
            <label for="excerpt" class="text-[14px] font-medium text-on-light">خلاصه</label>
            <textarea id="excerpt" name="Excerpt" rows="2" class="@fieldCls min-h-20 resize-y leading-[1.9]">@Model.Excerpt</textarea>
            <p class="text-[12.5px] leading-[1.9] text-on-light-muted">دو خط که در فهرست وبلاگ و در نتیجه‌ی گوگل زیر عنوان می‌آید. خالی بماند، از ابتدای متن ساخته می‌شود.</p>
        </div>

        <div class="flex flex-col gap-2">
            <label for="body" class="text-[14px] font-medium text-on-light">متن نوشته</label>
            @* CKEditor جای این textarea را می‌گیرد و موقع ارسال فرم خودش مقدار را برمی‌گرداند. *@
            @* EditorHtml: نوشته‌های قدیمیِ Markdown به HTML تبدیل شده‌اند تا در ویرایشگر درست دیده شوند. *@
            <textarea id="body" name="Body" rows="16" class="@fieldCls">@(Model.EditorHtml.Length > 0 ? Model.EditorHtml : Model.Body)</textarea>
            <p id="word-count" class="text-[12.5px] leading-[1.9] text-on-light-muted mt-2"></p>
        </div>

        <div class="flex flex-col gap-2">
            <label for="tags" class="text-[14px] font-medium text-on-light">برچسب‌ها</label>
            <input id="tags" name="TagsText" type="text" class="@fieldCls" value="@Model.TagsText" placeholder="اتوماسیون، اینستاگرام، پشتیبانی" />
            <p class="text-[12.5px] leading-[1.9] text-on-light-muted">با ویرگول جدا کن. حداکثر هشت برچسب.</p>
        </div>

        <div class="flex flex-col gap-3 rounded-xl border border-hairline bg-card p-4">
            <label class="flex items-center gap-3 text-[14px] text-on-light">
                <input type="checkbox" name="Published" value="true" checked="@(Model.Published ? "checked" : null)" class="h-5 w-5 rounded border-hairline text-brand" />
                @* تیکِ برداشته‌شده هیچ مقداری نمی‌فرستد؛ این فیلدِ پنهان یعنی
                   سرور همیشه یک مقدار صریح می‌گیرد. (همان کاری که تگ‌هلپرِ
                   asp-for خودکار انجام می‌دهد.) *@
                <input type="hidden" name="Published" value="false" />
                منتشر شود (روی سایت دیده شود)
            </label>
            <label class="flex items-center gap-3 text-[14px] text-on-light">
                <input type="checkbox" name="CommentsOpen" value="true" checked="@(Model.CommentsOpen ? "checked" : null)" class="h-5 w-5 rounded border-hairline text-brand" />
                <input type="hidden" name="CommentsOpen" value="false" />
                ثبت نظر برای این نوشته باز باشد
            </label>
        </div>

        <div>
            <button type="submit" class="inline-flex min-h-11 items-center rounded-xl bg-gradient-to-l from-brand-deep to-brand-2-deep px-6 text-[15px] font-medium text-white transition-transform duration-200 hover:-translate-y-0.5">ذخیره</button>
        </div>
    </form>

    @if (Model.PreviewHtml.Length > 0)
    {
        @* پیش‌نمایشِ سرور-رندر: بعد از هر ذخیره تازه می‌شود. برای پیش‌نمایشِ
           زنده حین تایپ، جاوااسکریپت لازم بود و پنل عمداً بدون آن کار
           می‌کند. *@
        <section class="rounded-2xl border border-hairline bg-card p-6">
            <h2 class="text-[16px] font-bold text-on-light">پیش‌نمایش متن</h2>
            <p class="mt-1 text-[12.5px] text-on-light-muted">همان‌طور که روی سایت دیده می‌شود (بعد از آخرین ذخیره).</p>
            <div class="mt-4 border-t border-hairline pt-2">@Html.Raw(Model.PreviewHtml)</div>
        </section>
    }
</div>

@* فایل‌های CKEditor 43.3.1 داخل خودِ پروژه (wwwroot/lib) هستند، نه CDN؛ cdn.ckeditor.com از ایران در دسترس نیست. *@
<script src="/lib/ckeditor5/ckeditor5.umd.js"></script>
<script src="/lib/ckeditor5/translations/fa.umd.js"></script>
<script>
    const C = window.CKEDITOR;
    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

    // هر سطر باید پاراگراف خودش باشد: اگر چند سطر با <br> در یک پاراگراف باشند، دکمه‌ی
    // فهرست (و تیتر و ترازبندی) روی کل پاراگراف اعمال می‌شود، نه فقط سطرهای انتخاب‌شده.
    const splitBr = html => html.replace(/<p([^>]*)>([\s\S]*?)<\/p>/gi, (m, attrs, inner) =>
        /<br\s*\/?>/i.test(inner)
            ? inner.split(/<br\s*\/?>/i).filter(s => s.trim()).map(s => `<p${attrs}>${s}</p>`).join('')
            : m);
    const esc = s => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    const bodyField = document.getElementById('body');
    bodyField.value = splitBr(bodyField.value);

    // اگر فایل ویرایشگر لود نشود، همان textarea ساده می‌ماند و فرم همچنان کار می‌کند.
    if (!C) document.getElementById('word-count').textContent = 'ویرایشگر بارگذاری نشد؛ متن را در همین کادر بنویسید.';
    else C.ClassicEditor.create(bodyField, {
        plugins: [
            C.Essentials, C.Paragraph, C.Heading, C.Autoformat, C.TextTransformation, C.PasteFromOffice,
            C.Bold, C.Italic, C.Underline, C.Strikethrough, C.Subscript, C.Superscript, C.Code, C.RemoveFormat,
            C.FontSize, C.FontColor, C.FontBackgroundColor, C.Highlight, C.Alignment,
            C.Link, C.AutoLink, C.List, C.ListProperties, C.Indent, C.IndentBlock,
            C.BlockQuote, C.CodeBlock, C.HorizontalLine, C.SpecialCharacters, C.SpecialCharactersEssentials,
            C.Image, C.ImageCaption, C.ImageStyle, C.ImageToolbar, C.ImageUpload, C.ImageResize,
            C.ImageInsert, C.ImageTextAlternative, C.LinkImage, C.AutoImage, C.SimpleUploadAdapter,
            C.Table, C.TableToolbar, C.TableProperties, C.TableCellProperties, C.TableCaption, C.TableColumnResize,
            C.MediaEmbed, C.FindAndReplace, C.SourceEditing, C.WordCount, C.ShowBlocks,
        ],
        toolbar: {
            items: [
                'undo', 'redo', '|', 'heading', '|',
                'bold', 'italic', 'underline', 'strikethrough', 'code', 'subscript', 'superscript', 'removeFormat', '|',
                'fontSize', 'fontColor', 'fontBackgroundColor', 'highlight', '|',
                'alignment', 'bulletedList', 'numberedList', 'outdent', 'indent', '|',
                'link', 'insertImage', 'insertTable', 'mediaEmbed', 'blockQuote', 'codeBlock', 'horizontalLine', 'specialCharacters', '|',
                'findAndReplace', 'showBlocks', 'sourceEditing',
            ],
            shouldNotGroupWhenFull: false,
        },
        language: { ui: 'fa', content: 'fa' },
        translations: [ window.CKEDITOR_TRANSLATIONS ],
        heading: {
            options: [
                { model: 'paragraph', title: 'پاراگراف', class: 'ck-heading_paragraph' },
                { model: 'heading2', view: 'h2', title: 'تیتر ۲', class: 'ck-heading_heading2' },
                { model: 'heading3', view: 'h3', title: 'تیتر ۳', class: 'ck-heading_heading3' },
                { model: 'heading4', view: 'h4', title: 'تیتر ۴', class: 'ck-heading_heading4' },
            ],
        },
        image: {
            toolbar: [ 'imageStyle:inline', 'imageStyle:block', 'imageStyle:side', '|',
                       'toggleImageCaption', 'imageTextAlternative', 'linkImage', '|', 'resizeImage' ],
        },
        table: {
            contentToolbar: [ 'tableColumn', 'tableRow', 'mergeTableCells', 'tableProperties', 'tableCellProperties', 'toggleTableCaption' ],
        },
        list: { properties: { styles: true, startIndex: true, reversed: true } },
        link: { addTargetToExternalLinks: true, defaultProtocol: 'https://' },
        // previewsInData: خروجی خودِ iframe را دارد، پس ویدیو روی سایت هم بدون جاوااسکریپت پخش می‌شود.
        mediaEmbed: { previewsInData: true },
        codeBlock: {
            languages: [
                { language: 'plaintext', label: 'متن ساده' },
                { language: 'csharp', label: 'C#' }, { language: 'javascript', label: 'JavaScript' },
                { language: 'python', label: 'Python' }, { language: 'html', label: 'HTML' },
                { language: 'css', label: 'CSS' }, { language: 'sql', label: 'SQL' },
                { language: 'bash', label: 'Bash' }, { language: 'json', label: 'JSON' },
            ],
        },
        simpleUpload: {
            uploadUrl: '/admin/posts/upload-image',
            headers: { 'RequestVerificationToken': token },
        },
        wordCount: {
            onUpdate: s => {
                document.getElementById('word-count').textContent =
                    `${s.words.toLocaleString('fa-IR')} کلمه · ${s.characters.toLocaleString('fa-IR')} نویسه`;
            },
        },
    })
    .then(editor => {
        window.editorInstance = editor;
        // Paste: هر سطرِ متن ساده یک پاراگراف؛ در HTMLِ چسبانده‌شده هم <br>ها پاراگراف می‌شوند.
        editor.editing.view.document.on('clipboardInput', (evt, data) => {
            const html = data.dataTransfer.getData('text/html');
            const text = data.dataTransfer.getData('text/plain');
            const out = html
                ? splitBr(html)
                : text.split(/\r?\n/).filter(l => l.trim()).map(l => `<p>${esc(l)}</p>`).join('');
            if (out) data.content = editor.data.htmlProcessor.toView(out);
        }, { priority: 'high' });
    })
    .catch(err => console.error('CKEditor initialization error:', err));
</script>
